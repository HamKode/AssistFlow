# URL of the Make.com Custom Webhook that receives chat messages
# (Scenario 1 — see docs/phase-1-make-groq-setup.md). Server-side only,
# never exposed to the browser.
MAKE_WEBHOOK_URL=

# URL of the Make.com Custom Webhook that receives star ratings / written
# feedback from the /feedback page (Scenario B — see
# docs/phase-5-8-feedback.md). Server-side only.
MAKE_FEEDBACK_WEBHOOK_URL=

# Read-only Airtable Personal Access Token + Base ID for the /dashboard
# analytics page (see docs/phase-9-analytics.md). This app only reads with
# it (Conversations, Tickets, Feedback tables) — it never writes, so scope
# the token to data.records:read + schema.bases:read only.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# NOTE: the Groq API key does NOT go here. It lives inside the Make.com
# scenario (in the HTTP module's header or a Make "Data store"/connection),
# never in this Next.js app. Keeping it there means it's never shipped to
# the browser and never committed to this repo.
